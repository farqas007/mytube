{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "mytube",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "mytube_index",
      "database_name": "mytube-index",
      "database_id": "01699816-7049-44c6-870a-51388dbc927e",
      "remote": true
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
