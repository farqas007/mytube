{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "mytube",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // The Worker runs first only for the API and for the watch page. /watch needs
    // it to render per-video <title>/canonical/og metadata into public/watch.html
    // before the response leaves the edge; /watch.html is listed so the Worker can
    // 301 the on-disk filename onto the canonical /watch URL. Every other asset
    // (including watch.js itself, which is NOT matched by these exact paths) is
    // still served straight from the asset binding without invoking the Worker.
    "run_worker_first": ["/api/*", "/watch", "/watch.html"]
  },
  "d1_databases": [
    {
      "binding": "mytube_index",
      "database_name": "mytube-index",
      "database_id": "01699816-7049-44c6-870a-51388dbc927e",
      "remote": true
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
