+  const fetchedAt = Number(row.metadata_fetched_at_ms);
+
+  if (!Number.isFinite(fetchedAt)) {
+    return false;
+  }
+
+  const age = now - fetchedAt;
+
+  if (age > VIDEO_INDEX_TTL_MS || age < -VIDEO_INDEX_CLOCK_SKEW_MS) {
+    return false;
+  }
