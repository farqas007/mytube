# MyTube backend configuration (youtube-server)
#
# Copy this file to `.env` in the project root and fill in your real key.
# The `.env` file must NOT be committed to git and is blocked from being
# served by the backend static server.

# Official YouTube Data API v3 key (server-side only, never exposed to browser)
YOUTUBE_API_KEY=

# Port the MyTube backend listens on (default 3456)
PORT=3456
